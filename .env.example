APP_MODE=live
SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=replace-with-a-different-password
POSTGRES_PASSWORD=replace-with-a-database-password
SECURE_COOKIES=false
EMBEDDED_SCHEDULER=true
# Local default: data/live.db. Production is configured by compose.yaml.
# DATABASE_URL=postgresql+psycopg://didban:password@localhost:5432/didban
# SNAPPSHOP_PROXY=http://authorized-iran-proxy:port
REQUEST_DELAY_SECONDS=1
REQUEST_TIMEOUT_SECONDS=25
MAX_REPORT_ROWS=200000
