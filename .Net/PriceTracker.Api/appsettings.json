{
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PriceTracker",
    "Audience": "PriceTracker.Panel",
    "LifetimeMinutes": 15,
    "RefreshLifetimeDays": 7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
